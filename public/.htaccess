# longevity-project.de: statische Seite auf Hostinger (Apache/LiteSpeed)
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# https und ohne www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://longevity-project.de%{REQUEST_URI} [L,R=301]

# Alte WordPress-Adressen auf passende neue Ziele
RewriteRule ^feed/?$ /blog/ [L,R=301]
RewriteRule ^(.+)/feed/?$ /$1/ [L,R=301]
RewriteRule ^category/ /blog/ [L,R=301]
RewriteRule ^author/ /ueber-mich/ [L,R=301]
RewriteRule ^sitemap_index\.xml$ /sitemap-index.xml [L,R=301]
RewriteRule ^(post|page|category|author)-sitemap\.xml$ /sitemap-index.xml [L,R=301]
RewriteRule ^wp-sitemap\.xml$ /sitemap-index.xml [L,R=301]
RewriteRule ^kontakt/?$ /contact/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
<FilesMatch "\.(woff2|jpg|jpeg|png|webp|svg|js|css)$">
  Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>
