---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const artikel = (await getCollection('site'))
  .filter((e) => e.data.type === 'artikel' && !e.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Blog" description="Alle Artikel im Überblick: Nahrungsergänzung, Ernährung und Longevity, verständlich und mit Quellen eingeordnet." url="/blog/">
  <section class="wrap" style="padding-top: 3rem">
    <h1>Blog</h1>
    <p>{artikel.length} Artikel, neueste zuerst.</p>
    <ul class="karten">
      {
        artikel.map((a) => (
          <li>
            <a class="karte" href={a.data.url}>
              {a.data.image ? <img src={a.data.image} alt="" loading="lazy" width="1024" height="683" /> : <div class="platz" />}
              <div>
                {a.data.category && <span class="kat">{a.data.category}</span>}
                <h3>{a.data.title}</h3>
                <p>{a.data.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
